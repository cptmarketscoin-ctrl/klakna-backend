# ==================== 数据库配置 ====================
DB_USER=your_db_user
DB_PASSWORD=your_strong_password
DB_NAME=your_db_name

# ==================== Redis 配置 ====================
REDIS_URL=redis://redis:6379

# ==================== 应用配置 ====================
NODE_ENV=production
PORT=3000

# ==================== JWT 密钥 ====================
# 使用 openssl rand -base64 32 生成
JWT_SECRET=your_32_character_secret_here

# ==================== 日志配置 ====================
LOG_LEVEL=info

# ==================== 其他配置 ====================
APP_NAME=YourAppName
APP_VERSION=1.0.0
